  "policySchemaVersion": 1,
  "requiredEnv": {
    "T3CODE_TELEMETRY_ENABLED": "false",
    "T3CODE_OTEL_SDK_DISABLED": "true"
  },
  "profiles": {
    "standard": {
      "description": "Blocks usage telemetry, T3 Connect, and auto/nightly updates while keeping Tailscale remote access usable.",
      "limits": {
        "telemetry": false,
        "connect": false,
        "updates": {
          "mode": "off",
          "allowNightly": false
        }
      },
      "settings": {}
    },
    "strict": {
      "description": "Adds locks on webhook tasks, browser cookie import, preview tunnel, and provider CLI update checks.",
      "limits": {
        "telemetry": false,
        "connect": false,
        "webhookTasks": false,
        "browserCookieImport": false,
        "previewTunnel": false,
        "updates": {
          "mode": "off",
          "allowNightly": false
        }
      },
      "settings": {
        "enableProviderUpdateChecks": {
          "value": false,
          "locked": true
        }
      }
    }
  },
  "forbiddenUserSettings": {
    "always": [
      "publishAgentActivity"
    ],
    "strictOnly": [
      "enableProviderUpdateChecks"
    ]
  },
  "forbiddenProcesses": [
    "cloudflared"
  ],
  "exitCodes": {
    "VERIFIED": 0,
    "FAIL": 1,
    "PENDING_RESTART": 10,
    "DRIFT_DETECTED": 20,
    "INCOMPLETE": 30
  },
